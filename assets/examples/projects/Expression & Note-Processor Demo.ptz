      "patch": {
        "name": "Expr Lead",
        "version": "1.0",
        "description": "Detuned 3-voice sawtooth lead → lowpass filter (slight drive) → ensemble chorus → tempo-synced ping-pong delay → plate reverb. Sustained, exposed tone chosen so per-note expression — vibrato, portamento/glissando, accent vs ghost, legato ties and ornaments — is clearly audible. Medium attack/release lets glides and vibrato breathe.",
        "modules": [
          {
            "id": "osc-1",
            "type": "oscillator",
