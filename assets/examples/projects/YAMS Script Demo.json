              "slot_15_dest": "none",
              "slot_15_enabled": 1.0,
              "slot_15_source": "none",
              "slot_16_amount": 0.0,
              "slot_16_dest": "none",
              "slot_16_enabled": 1.0,
              "slot_16_source": "none",
              "slot_1_amount": 0.0,
              "slot_1_dest": "flt-1.cutoff",
              "slot_1_enabled": 1.0,
              "slot_1_source": "none",
              "slot_2_amount": 0.0,
              "slot_2_dest": "osc-1.detune",
              "slot_2_enabled": 1.0,
              "slot_2_source": "none",
              "slot_3_amount": 0.0,
              "slot_3_dest": "amp-1.level",
              "slot_3_enabled": 1.0,
              "slot_3_source": "none",
              "slot_4_amount": 0.0,
              "slot_4_dest": "flt-1.resonance",
              "slot_4_enabled": 1.0,
              "slot_4_source": "none",
              "slot_5_amount": 0.0,
              "slot_5_dest": "amp-1.pan",
              "slot_5_enabled": 1.0,
              "slot_5_source": "none",
              "slot_6_amount": 0.0,
              "slot_6_dest": "lfo-1.rate",
              "slot_6_enabled": 1.0,
              "slot_6_source": "none",
              "slot_7_amount": 0.0,
              "slot_7_dest": "flt-1.drive",
              "slot_7_enabled": 1.0,
              "slot_7_source": "none",
              "slot_8_amount": 0.0,
              "slot_8_dest": "osc-1.level",
              "slot_8_enabled": 1.0,
              "slot_8_source": "none",
              "slot_9_amount": 0.0,
              "slot_9_dest": "flt-1.cutoff",
              "slot_9_enabled": 1.0,
              "slot_9_source": "none"
            },
            "scripts": {
              "1": "# Velocity -> filter brightness, smoothed (lag) so it glides instead of stepping.\n\nout = lag(velocity, 40ms)\n",
              "2": "# Pitch vibrato (LFO -> detune); the mod wheel opens the depth from subtle to wide.\n\nsrc vib = lfo-1.out\n\nout = vib * lerp(0.05, 0.4, mod_wheel)\n",
              "3": "# Tremolo that fades with the note: LFO times the envelope, so it tapers on release.\n\nsrc lfo = lfo-1.out\nsrc eg = env-1.out\n\nout = lfo * eg * 0.4\n",
              "4": "# Built-in 3 Hz resonance wobble (phasor + sin); only strong on hard hits (velocity > 0.7).\n\nlet lfo2 = sin(phasor(3) * tau) * 0.5\n\nout = velocity > 0.7 ? lfo2 : lfo2 * 0.2\n",
              "5": "# Slow auto-pan that widens as the note ages (smoothstep ramps it in over 1.5 s).\n\nout = sin(phasor(0.3) * tau) * smoothstep(0, 1.5, age) * 0.7\n",
              "6": "# Sample & hold: grab a new random value 4x/sec (clocked by a sine zero-crossing)\n# and use it to jump the main LFO's rate around in steps.\n\nout = sah(white(), sin(phasor(4) * tau)) * 0.3\n",
              "7": "# Slew limiter on the LFO: slow rise (2/s), fast fall (8/s) makes an asymmetric\n# ramp that animates the filter drive.\n\nsrc lfo = lfo-1.out\n\nout = slew(lfo, 2, 8) * 0.4\n",
              "8": "# White noise on the oscillator level - a subtle amplitude shimmer / analog instability.\n\nout = white() * 0.08\n",
              "9": "# Array step sequencer: an 8-step cutoff pattern that advances one step per beat\n# (arrays + the transport `beat` var). Wrap with `% len(steps)` so it loops.\n\narr steps = [0.2, 0.5, 0.8, 0.4, 1, 0.3, 0.6, 0.15]\n\nout = steps[floor(beat) % len(steps)] * 0.5\n"
            }
          }
        ],
