            "position": {
              "x": 832.0,
              "y": 384.0
            },
            "description": "Amp envelope (~120 ms decay) driving the VCA cv — the overall hit decay/tail.",
            "parameters": {
              "atk_curve": -1.0,
              "attack": 0.001,
              "dec_curve": -0.6,
              "decay": 0.12,
              "rel_curve": -0.4,
              "release": 0.08,
              "sustain": 0.0,
              "vel_sens": 1.0
