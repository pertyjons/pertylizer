              "x": 32.0,
              "y": 576.0
            },
            "description": "Ultra-fast envelope (~30 ms) modulating the oscillator pitch (FM) — the body's pitch-drop transient.",
            "parameters": {
              "atk_curve": -0.9,
              "attack": 0.001,
              "dec_curve": -0.8,
              "decay": 0.03,
              "rel_curve": -0.5,
              "release": 0.01,
              "sustain": 0.0,
              "vel_sens": 1.0
            }
