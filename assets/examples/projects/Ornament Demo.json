      "description": "Electronic snare (example 'Snare Drum' patch). The ornament carrier: its backbeat hits (beats 2 & 4) get the per-note flam/drag/ruff/roll/grace figures. Signal: white-noise snap, band-passed, blended with a pitch-swept triangle body.",
      "allocation_mode": "Polyphonic",
      "stealing_strategy": "Oldest",
      "max_voices": 8,
      "velocity_amp_sensitivity": 1.0,
      "velocity_filter_sensitivity": 0.5,
      "patch": {
        "name": "Snare Drum",
        "version": "1.0",
        "modules": [
          {
            "id": "osc-1",
            "type": "oscillator",
            "position": {
              "x": 32.0,
              "y": 32.0
            },
            "description": "Triangle oscillator — the tuned snare 'body'/thud (mixer in1). Its pitch is FM-driven by env-1.",
            "parameters": {
              "anti_alias": "polyblep",
              "detune": 0.0,
              "fm_amt": 1.0,
              "fm_mode": "exponential",
              "frequency": 440.0,
              "level": 0.6,
              "pulse_width": 0.5,
              "uni_detune": 10.0,
              "uni_phase": 1.0,
              "uni_spread": 0.5,
              "unison": 1.0,
              "waveform": "triangle",
              "x_mod": 0.0
            }
          },
          {
            "id": "nse-1",
            "type": "noise",
            "position": {
              "x": 32.0,
              "y": 384.0
            },
            "description": "White-noise source — the snare's 'snap'/rattle. Feeds the filter.",
            "parameters": {
              "level": 0.7,
              "type": "white"
            }
          },
          {
            "id": "flt-1",
            "type": "filter",
            "position": {
              "x": 448.0,
              "y": 32.0
            },
            "description": "Band-shapes the noise (~5 kHz) into the bright snare snap, then into the mixer (in2).",
            "parameters": {
              "cutoff": 5000.0,
              "cv_amt": 1.0,
              "drive": 1.0,
              "env_amt": 0.25,
              "key_track": 0.0,
              "model": "standard",
              "morph": 0.0,
              "resonance": 0.3,
              "type": "bandpass"
