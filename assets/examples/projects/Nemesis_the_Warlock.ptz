    {
      "id": 7,
      "name": "V1 Lead",
      "channel": 1,
      "volume": 0.16666667,
      "pan": 0.0,
      "muted": false,
      "solo": false,
      "key_range": [
        0,
        127
      ],
      "transpose": -0.0011545205,
      "oversampling": 1,
      "category": 4,
      "description": "SID voice 1 — a waveform-alternation lead: two SID oscillators (tonal carrier + alternate waveform) gated in anti-phase by two frame-rate square LFOs, so exactly one sounds each frame. No ring/neighbour source (unlike instrument 1). The main voice-1 melodic workhorse (656 notes).",
      "allocation_mode": "Mono",
      "stealing_strategy": "Oldest",
      "unison_detune": 10.0,
      "unison_spread": 0.0,
      "max_voices": 1,
      "velocity_amp_sensitivity": 1.0,
      "velocity_filter_sensitivity": 0.0,
      "patch": {
        "name": "V1 Lead",
        "version": "1.0",
        "description": "Waveform-alternation SID lead (no ring). sid-1 (tonal carrier) and sid-2 (alternate waveform) run continuously and are gated in anti-phase by lfo-1/lfo-2 (frame-rate squares, phase 0 and 0.5) into amp-2/amp-3, so exactly one is heard per frame — reproducing the SID per-frame waveform switch. Summed in mix-1, then env-1 shapes amp-1 → stereo out. 6581/PAL.",
        "modules": [
          {
            "id": "env-1",
            "type": "envelope",
            "position": {
              "x": 960.0,
              "y": 448.0
            },
            "description": "Note ADSR gating the main VCA (amp-1).",
            "parameters": {
              "atk_curve": 0.0,
              "attack": 0.008,
              "dec_curve": -0.5,
              "decay": 0.114,
              "rel_curve": -0.5,
              "release": 0.75,
              "sustain": 0.6666667,
              "vel_sens": 1.0
            }
          },
          {
            "id": "lfo-1",
            "type": "lfo",
            "position": {
              "x": 32.0,
              "y": 32.0
            },
            "description": "Alternation clock A: frame-rate square (phase 0) gating side A — switches once per driver frame.",
            "parameters": {
              "depth": 1.0,
              "phase": 0.0,
              "rate": 25.0,
              "retrigger": false,
              "sync_division": 1.0,
              "tempo_sync": false,
              "waveform": "square"
            }
          },
          {
            "id": "lfo-2",
            "type": "lfo",
            "position": {
              "x": 32.0,
              "y": 672.0
            },
            "description": "Alternation clock B: frame-rate square (phase 0.5), anti-phase to lfo-1, gating side B.",
            "parameters": {
              "depth": 1.0,
              "phase": 0.5,
              "rate": 25.0,
              "retrigger": false,
              "sync_division": 1.0,
              "tempo_sync": false,
              "waveform": "square"
            }
          },
          {
            "id": "amp-1",
            "type": "amplifier",
            "position": {
              "x": 1376.0,
              "y": 32.0
            },
            "description": "Main VCA: the summed alternating signal gained by the note envelope (env-1).",
            "parameters": {
              "cv_bipolar": false,
              "level": 1.0,
              "pan": 0.0
            }
          },
          {
            "id": "amp-2",
            "type": "amplifier",
            "position": {
              "x": 640.0,
              "y": 32.0
            },
            "description": "Side-A gate: passes sid-1 while lfo-1's square is high.",
            "parameters": {
              "cv_bipolar": false,
              "level": 1.0,
              "pan": 0.0
            }
          },
          {
            "id": "amp-3",
            "type": "amplifier",
