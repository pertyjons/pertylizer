  "active_instrument_id": 1,
  "author": {
    "name": "Per Jonsson",
    "email": "pertyjons@gmail.com",
    "website": "https://github.com/pertyjons"
  },
  "song": {
    "name": "Nemesis the Warlock",
    "author": "Rob Hubbard",
    "description": "Automatic sid-analyzer export of Rob Hubbard's \"Nemesis the Warlock\" (C64, 1987), subtune 1 (~6:52). Reconstructed from a cycle-accurate emulation of the original 6581 SID driver: the per-frame $D400–$D41C register trace was analysed into notes, ADSR, waveforms, pulse-width, filter and effects, then rebuilt on Pertylizer's native `sid_oscillator` module (MOS 6581, PAL). This is the generic trace-derived path (no driver-native extractor for this Hubbard variant), so per-frame modulation rides automation lanes rather than authored programs. One Pertylizer instrument per merged SID-voice timbre; the three physical SID voices are split across 7 tracks by role (lead / bass / ring-modulated lead / drums). Signature timbres: voice-2's ring-modulated triangle lead alternating with chip noise every frame, and the pitch-drop percussion. Tempo 93.75 BPM derived from the driver's note onsets.",
    "patterns": [
      {
        "id": 0,
        "name": "V2 triangle flt rng",
        "description": "Voice-2 ring-modulated triangle lead (with tri↔noise alternation + filter), full song span (650 beats), 108 notes — the sparse, sustained statements of the signature metallic hook.",
        "length": 624000,
