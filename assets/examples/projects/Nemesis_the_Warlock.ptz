    {
      "id": 4,
      "name": "V2 triangle flt",
      "channel": 1,
      "volume": 0.16666667,
      "pan": 0.0,
      "muted": false,
      "solo": false,
      "key_range": [
        0,
        127
      ],
      "transpose": 0.003614328,
      "oversampling": 1,
      "category": 0,
      "description": "SID voice 2 — the filtered triangle lead WITHOUT ring modulation (the non-ring sections of voice 2). Single SID oscillator (triangle) → lowpass filter → VCA. Shares voice 2 with instrument 1; the two never sound at once (a SID voice is monophonic).",
      "allocation_mode": "Polyphonic",
      "stealing_strategy": "Oldest",
      "unison_detune": 10.0,
      "unison_spread": 0.0,
      "max_voices": 4,
      "velocity_amp_sensitivity": 1.0,
      "velocity_filter_sensitivity": 0.0,
      "patch": {
        "name": "V2 triangle flt",
        "version": "1.0",
        "description": "Filtered SID voice: sid_oscillator (triangle, 6581/PAL) → flt-1 lowpass (cutoff ~5.7 kHz) → VCA gated by env-1 → stereo out. The voice-2 triangle lead in its non-ring sections; the SID's single global filter is approximated with one per-instrument filter instance. Cutoff sweeps (if present in the trace) ride an automation lane on flt-1.cutoff.",
        "modules": [
          {
            "id": "flt-1",
            "type": "filter",
            "position": {
              "x": 640.0,
              "y": 32.0
            },
            "description": "Lowpass filter (cutoff ~5.7 kHz) approximating the SID global filter; cutoff sweeps ride an automation lane.",
            "parameters": {
              "cutoff": 9212.5,
              "cv_amt": 0.0,
              "drive": 1.0,
              "env_amt": 0.0,
              "key_track": 0.0,
              "model": "standard",
              "morph": 0.0,
              "resonance": 0.65,
              "type": "lowpass"
            }
          },
          {
            "id": "env-1",
