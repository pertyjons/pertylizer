{
  "file_type": "project",
  "version": "1.0",
  "instruments": [
    {
      "id": 1,
      "name": "V2 triangle flt rng",
      "channel": 1,
      "volume": 0.16666667,
      "pan": 0.0,
      "muted": false,
      "solo": false,
      "key_range": [
        0,
        127
      ],
      "transpose": 0.0018285805,
      "oversampling": 1,
      "category": 0,
      "description": "SID voice 2 — the signature Nemesis lead: a ring-modulated triangle carrier that alternates with chip noise every driver frame (the Hubbard tri↔noise idiom), routed through a lowpass filter (cutoff ~5.7 kHz). Ring source is a neighbour SID oscillator held at raw freq register 2805. The metallic, buzzing hook of the tune.",
      "allocation_mode": "Polyphonic",
      "stealing_strategy": "Oldest",
      "unison_detune": 10.0,
      "unison_spread": 0.0,
      "max_voices": 4,
      "velocity_amp_sensitivity": 1.0,
      "velocity_filter_sensitivity": 0.0,
      "patch": {
        "name": "V2 triangle flt rng",
        "version": "1.0",
        "description": "Ring-modulated + waveform-alternating SID voice. sid-1 (triangle, Ring Mod on) is the tonal carrier; its triangle fold XORs with sid-3's MSB (a saw held at freq reg 2805) to produce the inharmonic ring sidebands. sid-2 (noise) is the alternation partner. lfo-1/lfo-2 (25 Hz squares, anti-phase) gate amp-2/amp-3 so the carrier and noise swap every frame (noise boosted to 1.4). Summed in mix-1, lowpassed by flt-1 (~5.7 kHz), then env-1 shapes amp-1. 6581 model, PAL.",
        "modules": [
          {
            "id": "flt-1",
            "type": "filter",
            "position": {
              "x": 1984.0,
              "y": 32.0
            },
            "description": "Lowpass filter (cutoff ~5.7 kHz) approximating the SID's single global filter on this voice; cutoff sweeps ride an automation lane.",
            "parameters": {
              "cutoff": 5700.0,
              "cv_amt": 0.0,
              "drive": 1.0,
              "env_amt": 0.0,
              "key_track": 0.0,
              "model": "standard",
              "morph": 0.0,
              "resonance": 0.0,
              "type": "lowpass"
            }
          },
          {
            "id": "env-1",
            "type": "envelope",
            "position": {
              "x": 1984.0,
              "y": 352.0
            },
            "description": "Note ADSR (attack 2 ms, decay 3 s, sustain 0, release 1.5 s) shaping the summed voice via amp-1.",
            "parameters": {
              "atk_curve": 0.0,
              "attack": 0.002,
              "dec_curve": -0.5,
              "decay": 3.0,
              "rel_curve": -0.5,
              "release": 1.5,
              "sustain": 0.0,
              "vel_sens": 1.0
            }
          },
          {
            "id": "lfo-1",
            "type": "lfo",
            "position": {
              "x": 640.0,
              "y": 416.0
            },
            "description": "Alternation clock A: 25 Hz square, phase 0 — half the PAL frame rate, so the gated waveform switches exactly once per driver frame.",
            "parameters": {
              "depth": 1.0,
              "phase": 0.0,
              "rate": 25.0,
              "retrigger": false,
              "sync_division": 1.0,
              "tempo_sync": false,
              "waveform": "square"
            }
          },
          {
            "id": "lfo-2",
            "type": "lfo",
            "position": {
              "x": 640.0,
              "y": 672.0
            },
            "description": "Alternation clock B: 25 Hz square, phase 0.5 — anti-phase to lfo-1, gating the noise side so carrier and noise never sound together.",
            "parameters": {
              "depth": 1.0,
              "phase": 0.5,
              "rate": 25.0,
              "retrigger": false,
              "sync_division": 1.0,
              "tempo_sync": false,
              "waveform": "square"
            }
          },
          {
            "id": "amp-1",
            "type": "amplifier",
            "position": {
              "x": 2400.0,
              "y": 32.0
            },
            "description": "Main VCA: the summed carrier+noise mix gained by the note envelope (env-1) before the filter/output.",
            "parameters": {
              "cv_bipolar": false,
              "level": 1.0,
              "pan": 0.0
            }
          },
          {
            "id": "amp-2",
            "type": "amplifier",
            "position": {
              "x": 1248.0,
              "y": 32.0
            },
            "description": "Carrier gate: passes sid-1 while lfo-1's square is high (alternation phase A).",
            "parameters": {
              "cv_bipolar": false,
              "level": 1.0,
              "pan": 0.0
            }
          },
          {
            "id": "amp-3",
            "type": "amplifier",
            "position": {
              "x": 1248.0,
              "y": 352.0
            },
            "description": "Noise gate: passes sid-2 while lfo-2's square is high (alternation phase B); Level 1.4 boosts the noise so its grit carries against the ring tone.",
            "parameters": {
              "cv_bipolar": false,
              "level": 1.4,
              "pan": 0.0
            }
          },
          {
            "id": "mix-1",
            "type": "mixer",
            "position": {
              "x": 1568.0,
              "y": 32.0
            },
            "description": "Sums the two anti-phase-gated sides (carrier on in1, noise on in2) into one alternating signal.",
            "parameters": {
              "input_1": 1.0,
              "input_2": 1.0,
              "input_3": 1.0,
              "input_4": 1.0,
              "input_5": 1.0,
              "input_6": 1.0,
              "input_7": 1.0,
              "input_8": 1.0,
              "limit": false,
              "master": 1.0,
              "mute": false
            }
          },
          {
