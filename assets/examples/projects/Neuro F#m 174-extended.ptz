    {
      "id": 7,
      "name": "Pad",
      "channel": 1,
      "volume": 1.0,
      "pan": 0.0,
      "muted": false,
      "solo": false,
      "key_range": [
        0,
        127
      ],
      "transpose": 0.0,
      "oversampling": 1,
      "category": 3,
      "description": "Pad spelar genom HELA låten. F#m → A → F#m progression. FilterCutoff-automation sweepar 0.32 → 0.60 → 0.32 över varje 32-beat-pattern för långsam textur-rörelse.",
      "allocation_mode": "Polyphonic",
      "stealing_strategy": "Oldest",
      "unison_detune": 10.0,
      "unison_spread": 0.0,
      "max_voices": 8,
      "velocity_amp_sensitivity": 1.0,
      "velocity_filter_sensitivity": 0.0,
      "patch": {
        "name": "Pad",
        "version": "1.0",
        "description": "Två detunade saws (-10c/+10c, unison 3, uni_spread 1.0/0.85). Stereo voice-path via parallella lowpass-filter L/R med olika cutoff (1100/1300 Hz). Två LFOs på cutoff (sine 0.13 Hz / triangle 0.09 Hz, 180° fas) ger oberoende rörelse i L och R. Lång ADSR (A=0.8s, R=1.4s). Effect chain: ensemble chorus (mix 0.55) + hall reverb (low-cut 220 Hz, mix 0.30).",
        "modules": [
          {
            "id": "osc-1",
            "type": "oscillator",
            "position": {
              "x": 32.0,
              "y": 32.0
            },
            "parameters": {
              "anti_alias": "minblep",
              "detune": -10.0,
              "fm_amt": 1.0,
              "fm_mode": "exponential",
              "frequency": 440.0,
              "level": 0.55,
              "pulse_width": 0.5,
              "uni_detune": 14.0,
              "uni_phase": 1.0,
              "uni_spread": 1.0,
              "unison": 3.0,
              "waveform": "sawtooth",
              "x_mod": 0.0
            }
          },
          {
            "id": "osc-2",
            "type": "oscillator",
            "position": {
              "x": 32.0,
              "y": 384.0
            },
            "parameters": {
              "anti_alias": "minblep",
              "detune": 10.0,
              "fm_amt": 1.0,
              "fm_mode": "exponential",
              "frequency": 440.0,
              "level": 0.5,
              "pulse_width": 0.5,
              "uni_detune": 12.0,
              "uni_phase": 1.0,
              "uni_spread": 0.85,
              "unison": 3.0,
              "waveform": "sawtooth",
              "x_mod": 0.0
            }
