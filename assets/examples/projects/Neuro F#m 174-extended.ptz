      "velocity_filter_sensitivity": 0.0,
      "patch": {
        "name": "Snare",
        "version": "1.0",
        "description": "Bandpass white-noise (1.8 kHz, res 0.55) + triangle body (195 Hz). Body har FM-drop från en separat envelope för pitch-snap (±2 semi över 80ms). Effect chain: soft-clip → plate-reverb (mix 0.22) → ensemble chorus. Stereo voice-path via amp.left/right separately.",
        "modules": [
          {
            "id": "osc-1",
            "type": "oscillator",
            "position": {
              "x": 32.0,
              "y": 32.0
            },
