{
  "name": "Snare Drum",
  "author": "Modular Synth",
  "version": "1.1",
  "description": "Electronic snare with tuned body and noise snap.",
  "tags": ["drum", "snare", "percussion"],
  "modules": [
    {
      "id": 1,
      "type": "oscillator",
      "position": [50.0, 100.0],
      "parameters": {"waveform": "sine", "level": 0.6}
    },
    {
      "id": 2,
      "type": "oscillator",
      "position": [50.0, 250.0],
      "parameters": {"waveform": "noise", "level": 0.5}
    },
    {
      "id": 3,
      "type": "filter",
      "position": [250.0, 100.0],
      "parameters": {"filter_type": "lowpass", "cutoff": 300.0, "resonance": 0.2}
    },
    {
      "id": 31,
      "type": "filter",
      "position": [250.0, 250.0],
      "parameters": {"filter_type": "highpass", "cutoff": 2000.0, "resonance": 0.3}
    },
    {
      "id": 4,
      "type": "envelope",
      "position": [50.0, 400.0],
      "parameters": {"attack": 0.001, "decay": 0.12, "sustain": 0.0, "release": 0.08}
    },
    {
      "id": 5,
      "type": "envelope",
      "position": [200.0, 400.0],
      "parameters": {"attack": 0.001, "decay": 0.05, "sustain": 0.0, "release": 0.03}
    },
    {
      "id": 6,
      "type": "envelope",
      "position": [350.0, 400.0],
      "parameters": {"attack": 0.001, "decay": 0.15, "sustain": 0.0, "release": 0.1}
    },
    {
      "id": 8,
      "type": "amplifier",
      "position": [450.0, 170.0],
      "parameters": {"level": 0.85}
    },
    {
      "id": 200,
      "type": "oscilloscope",
      "position": [650.0, 100.0],
      "parameters": {"time_scale": 0.4, "gain": 1.2}
    },
    {
      "id": 201,
      "type": "level_meter",
      "position": [650.0, 280.0],
      "parameters": {}
    }
  ],
  "connections": [
    {"from": [1, "out"], "to": [3, "in"]},
    {"from": [2, "out"], "to": [31, "in"]},
    {"from": [3, "out"], "to": [8, "in"]},
    {"from": [31, "out"], "to": [8, "in"]},
    {"from": [4, "out"], "to": [8, "cv"]},
    {"from": [5, "out"], "to": [1, "fm"]},
    {"from": [6, "out"], "to": [31, "cutoff_cv"]},
    {"from": [8, "out"], "to": [200, "in"]}
  ],
  "settings": {"master_volume": 0.85, "bpm": 120.0, "octave_offset": -1}
}
