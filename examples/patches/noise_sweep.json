{
  "name": "Noise Sweep",
  "author": "Modular Synth",
  "version": "1.1",
  "description": "Dramatic filter sweep effect with noise and resonance.",
  "tags": ["effect", "sweep", "noise", "dramatic"],
  "modules": [
    {
      "id": 1,
      "type": "oscillator",
      "position": [50.0, 100.0],
      "parameters": {"waveform": "noise", "level": 0.8}
    },
    {
      "id": 3,
      "type": "filter",
      "position": [250.0, 100.0],
      "parameters": {"filter_type": "bandpass", "cutoff": 1000.0, "resonance": 0.85}
    },
    {
      "id": 4,
      "type": "envelope",
      "position": [50.0, 300.0],
      "parameters": {"attack": 0.5, "decay": 1.0, "sustain": 0.3, "release": 2.0}
    },
    {
      "id": 5,
      "type": "envelope",
      "position": [200.0, 300.0],
      "parameters": {"attack": 2.0, "decay": 0.5, "sustain": 0.6, "release": 1.5}
    },
    {
      "id": 6,
      "type": "lfo",
      "position": [350.0, 300.0],
      "parameters": {"waveform": "triangle", "rate": 0.2, "depth": 0.5}
    },
    {
      "id": 8,
      "type": "amplifier",
      "position": [450.0, 100.0],
      "parameters": {"level": 0.7}
    },
    {
      "id": 100,
      "type": "reverb",
      "position": [650.0, 100.0],
      "parameters": {"room_size": 0.8, "damping": 0.2, "mix": 0.5}
    },
    {
      "id": 200,
      "type": "oscilloscope",
      "position": [650.0, 300.0],
      "parameters": {"time_scale": 2.0, "gain": 1.2}
    },
    {
      "id": 201,
      "type": "level_meter",
      "position": [800.0, 300.0],
      "parameters": {}
    }
  ],
  "connections": [
    {"from": [1, "out"], "to": [3, "in"]},
    {"from": [3, "out"], "to": [8, "in"]},
    {"from": [4, "out"], "to": [8, "cv"]},
    {"from": [5, "out"], "to": [3, "cutoff_cv"]},
    {"from": [6, "out"], "to": [3, "cutoff_cv"]},
    {"from": [8, "out"], "to": [200, "in"]}
  ],
  "settings": {"master_volume": 0.65, "bpm": 80.0, "octave_offset": 0}
}
