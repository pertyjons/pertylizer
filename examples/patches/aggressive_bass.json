{
  "name": "Aggressive Bass",
  "author": "Modular Synth",
  "version": "1.1",
  "description": "Punchy, aggressive bass with distortion and filter sweep.",
  "tags": ["bass", "aggressive", "distortion"],
  "modules": [
    {
      "id": 1,
      "type": "oscillator",
      "position": [50.0, 100.0],
      "parameters": {"waveform": "sawtooth", "level": 0.8}
    },
    {
      "id": 2,
      "type": "oscillator",
      "position": [50.0, 230.0],
      "parameters": {"waveform": "square", "level": 0.5, "detune": -12.0}
    },
    {
      "id": 3,
      "type": "filter",
      "position": [250.0, 150.0],
      "parameters": {"filter_type": "lowpass", "cutoff": 500.0, "resonance": 0.6}
    },
    {
      "id": 4,
      "type": "envelope",
      "position": [50.0, 380.0],
      "parameters": {"attack": 0.002, "decay": 0.15, "sustain": 0.7, "release": 0.15}
    },
    {
      "id": 5,
      "type": "envelope",
      "position": [200.0, 380.0],
      "parameters": {"attack": 0.001, "decay": 0.2, "sustain": 0.3, "release": 0.1}
    },
    {
      "id": 8,
      "type": "amplifier",
      "position": [450.0, 150.0],
      "parameters": {"level": 0.8}
    },
    {
      "id": 100,
      "type": "distortion",
      "position": [650.0, 150.0],
      "parameters": {"drive": 0.6, "mix": 0.4}
    },
    {
      "id": 200,
      "type": "oscilloscope",
      "position": [650.0, 330.0],
      "parameters": {"time_scale": 1.0, "gain": 1.0}
    },
    {
      "id": 201,
      "type": "level_meter",
      "position": [800.0, 330.0],
      "parameters": {}
    }
  ],
  "connections": [
    {"from": [1, "out"], "to": [3, "in"]},
    {"from": [2, "out"], "to": [3, "in"]},
    {"from": [3, "out"], "to": [8, "in"]},
    {"from": [4, "out"], "to": [8, "cv"]},
    {"from": [5, "out"], "to": [3, "cutoff_cv"]},
    {"from": [8, "out"], "to": [200, "in"]}
  ],
  "settings": {"master_volume": 0.75, "bpm": 140.0, "octave_offset": -1}
}
