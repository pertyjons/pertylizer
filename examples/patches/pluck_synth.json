{
  "name": "Pluck Synth",
  "author": "Modular Synth",
  "version": "1.1",
  "description": "Short, plucky synthesizer for arpeggios and sequences.",
  "tags": ["pluck", "arpeggio", "sequence", "percussive"],
  "modules": [
    {
      "id": 1,
      "type": "oscillator",
      "position": [50.0, 100.0],
      "parameters": {"waveform": "sawtooth", "level": 0.7}
    },
    {
      "id": 3,
      "type": "filter",
      "position": [250.0, 100.0],
      "parameters": {"filter_type": "lowpass", "cutoff": 3000.0, "resonance": 0.4}
    },
    {
      "id": 4,
      "type": "envelope",
      "position": [50.0, 300.0],
      "parameters": {"attack": 0.001, "decay": 0.2, "sustain": 0.0, "release": 0.15}
    },
    {
      "id": 5,
      "type": "envelope",
      "position": [200.0, 300.0],
      "parameters": {"attack": 0.001, "decay": 0.15, "sustain": 0.1, "release": 0.1}
    },
    {
      "id": 8,
      "type": "amplifier",
      "position": [450.0, 100.0],
      "parameters": {"level": 0.75}
    },
    {
      "id": 100,
      "type": "delay",
      "position": [650.0, 100.0],
      "parameters": {"mode": "stereo", "time": 0.15, "feedback": 0.3, "mix": 0.25}
    },
    {
      "id": 200,
      "type": "oscilloscope",
      "position": [650.0, 300.0],
      "parameters": {"time_scale": 0.5, "gain": 1.0}
    },
    {
      "id": 201,
      "type": "level_meter",
      "position": [800.0, 300.0],
      "parameters": {}
    }
  ],
  "connections": [
    {"from": [1, "out"], "to": [3, "in"]},
    {"from": [3, "out"], "to": [8, "in"]},
    {"from": [4, "out"], "to": [8, "cv"]},
    {"from": [5, "out"], "to": [3, "cutoff_cv"]},
    {"from": [8, "out"], "to": [200, "in"]}
  ],
  "settings": {"master_volume": 0.8, "bpm": 130.0, "octave_offset": 0}
}
