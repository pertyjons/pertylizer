{
  "name": "Kick Drum",
  "author": "Modular Synth",
  "version": "1.1",
  "description": "Punchy electronic kick drum with pitch sweep.",
  "notes": "\nSIGNAL FLOW:\nA sine wave oscillator provides the fundamental thump. The pitch envelope\ncreates the characteristic 'boing' by sweeping from a higher frequency\ndown to the fundamental.\n\nThe amp envelope shapes the transient - fast attack for punch,\nquick decay for a tight sound.\n\nTIP: Adjust the pitch envelope decay for different kick characters:\n- Shorter = tighter, punchier\n- Longer = more 'boomy', 808-style\n\nVISUALIZERS:\nOscilloscope shows the pitch sweep clearly.\n",
  "tags": ["drum", "kick", "percussion", "bass"],
  "modules": [
    {
      "id": 1,
      "type": "oscillator",
      "position": [50.0, 100.0],
      "parameters": {
        "waveform": "sine",
        "level": 1.0
      }
    },
    {
      "id": 3,
      "type": "filter",
      "position": [250.0, 100.0],
      "parameters": {
        "filter_type": "lowpass",
        "cutoff": 200.0,
        "resonance": 0.1
      }
    },
    {
      "id": 4,
      "type": "envelope",
      "position": [50.0, 300.0],
      "parameters": {
        "attack": 0.001,
        "decay": 0.15,
        "sustain": 0.0,
        "release": 0.1
      }
    },
    {
      "id": 5,
      "type": "envelope",
      "position": [200.0, 300.0],
      "parameters": {
        "attack": 0.001,
        "decay": 0.08,
        "sustain": 0.0,
        "release": 0.05
      }
    },
    {
      "id": 8,
      "type": "amplifier",
      "position": [450.0, 100.0],
      "parameters": {
        "level": 0.9
      }
    },
    {
      "id": 200,
      "type": "oscilloscope",
      "position": [650.0, 100.0],
      "parameters": {
        "time_scale": 0.5,
        "gain": 1.0
      }
    },
    {
      "id": 201,
      "type": "level_meter",
      "position": [650.0, 280.0],
      "parameters": {}
    }
  ],
  "connections": [
    {"from": [1, "out"], "to": [3, "in"]},
    {"from": [3, "out"], "to": [8, "in"]},
    {"from": [4, "out"], "to": [8, "cv"]},
    {"from": [5, "out"], "to": [1, "fm"]},
    {"from": [8, "out"], "to": [200, "in"]}
  ],
  "settings": {
    "master_volume": 0.9,
    "bpm": 120.0,
    "octave_offset": -2
  }
}
